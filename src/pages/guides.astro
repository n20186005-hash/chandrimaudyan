---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guideClusters, allGuides } from '../data/guides';

export const prerender = true;

const siteUrl = Astro.site?.href.replace(/\/$/, '');
const pageUrl = siteUrl ? `${siteUrl}/guides/` : undefined;

const title = 'সব নির্দেশিকা — চন্দ্রিমা উদ্যান (Chandrima Udyan), ঢাকা';
const description = 'চন্দ্রিমা উদ্যানের ইতিহাস, খোলার সময়, যাতায়াত, কাছাকাছি দর্শনীয় স্থান, খাবার ও ভ্রমণ পরিকল্পনা—সব নির্দেশিকা এক পাতায়।';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  ...(pageUrl ? { '@id': `${pageUrl}#collection`, url: pageUrl } : {}),
  name: title,
  description,
  inLanguage: 'bn-BD',
  ...(siteUrl ? { isPartOf: { '@id': `${siteUrl}/#website` }, publisher: { '@id': `${siteUrl}/#organization` } } : {}),
  hasPart: allGuides.map((g) => ({
    '@type': 'Article',
    headline: g.label,
    ...(siteUrl ? { url: new URL(g.href, Astro.site).href } : {})
  }))
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'হোম', ...(siteUrl ? { item: `${siteUrl}/` } : {}) },
    { '@type': 'ListItem', position: 2, name: 'সব নির্দেশিকা' }
  ]
};
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbLd, collectionLd]}
  imageAlt="চন্দ্রিমা উদ্যান নির্দেশিকার তালিকা"
  altLocales={[
    { hreflang: 'bn-BD', href: '/guides/' },
    { hreflang: 'en', href: '/en/guides/' },
    { hreflang: 'x-default', href: '/guides/' }
  ]}
>
  <article class="guide hub">
    <div class="container">
      <nav class="guide-crumbs" aria-label="পথনির্দেশ">
        <a href="/">হোম</a><i aria-hidden="true">›</i><span aria-current="page">সব নির্দেশিকা</span>
        <a class="guide-lang" href="/en/guides/" hreflang="en" aria-label="Read this page in English">English</a>
      </nav>
      <p class="eyebrow">নির্দেশিকার তালিকা</p>
      <h1>চন্দ্রিমা উদ্যান সম্পর্কে সব নির্দেশিকা</h1>
      <div class="guide-answer">
        <b>সংক্ষেপে</b>
        <p>এখানে {allGuides.length}টি নির্দেশিকা পাঁচটি ভাগে সাজানো: উদ্যান ও ইতিহাস, পরিকল্পনা, যাতায়াত, কাছাকাছি স্থান ও খাবার, এবং রেডিমেড ভ্রমণ রুট। যাওয়ার আগে কোনটি দরকার সেই ভাগটি বেছে নিন।</p>
      </div>
      {guideClusters.map((cluster) => (
        <section class="hub-cluster" aria-labelledby={`hub-${cluster.key}`}>
          <h2 id={`hub-${cluster.key}`}>{cluster.title}</h2>
          <p class="hub-note">{cluster.note}</p>
          <ul class="guide-links">
            {cluster.items.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
      <p class="guide-updated">তথ্য হালনাগাদ: ২ নভেম্বর ২০২৬ · উৎস ও তারিখসহ স্বাধীন নির্দেশিকা; যাওয়ার আগে বর্তমান অবস্থা স্থানীয়ভাবে যাচাই করুন।</p>
      <div class="neutral-note">
        <b>স্বাধীন প্রকল্পের ঘোষণা</b>এটি কোনো সরকারি সংস্থার ওয়েবসাইট নয়; কোনো হোটেল, রেস্তোরাঁ বা দোকান সুপারিশ করা হয় না। প্রতিটি পাতার উৎস ও হালনাগাদের তারিখ আলাদাভাবে দেওয়া আছে।
      </div>
    </div>
  </article>
</BaseLayout>

<style>
.hub h1{margin-bottom:1.2rem}
.hub-cluster{margin-top:2.8rem}
.hub-cluster h2{font-size:clamp(1.4rem,3vw,1.9rem);font-weight:900;margin:0 0 .35rem}
.hub-note{margin:0 0 1rem;color:var(--muted);font-size:.95rem}
</style>
