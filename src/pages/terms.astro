---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout title="সেবার শর্তাবলি — চন্দ্রিমা উদ্যান ঢাকা ভ্রমণ নির্দেশিকা" description="চন্দ্রিমা উদ্যান ঢাকা ভ্রমণ নির্দেশিকার সেবার শর্তাবলি।">
  <section class="section legal"><div class="container" style="max-width:850px">
    <p class="eyebrow">নীতিমালা</p><h1>সেবার শর্তাবলি</h1><p><strong>শেষ হালনাগাদ:</strong> সেপ্টেম্বর ২০২৬</p>
    <p>এই ওয়েবসাইটে প্রবেশ ও ব্যবহার করার মাধ্যমে আপনি এসব শর্তাবলি মেনে নেওয়ার সম্মতি দিচ্ছেন।</p>
    <h2>বিষয়বস্তুর ব্যবহার</h2><p>সব তথ্য কেবল দর্শনার্থী নির্দেশনা ও সাধারণ তথ্যের জন্য। এটি স্বাধীন তৃতীয়-পক্ষের ভ্রমণ তথ্য প্রকল্প; চন্দ্রিমা উদ্যান, কোনো সরকারি সংস্থা বা বাণিজ্যিক পরিচালকের সঙ্গে এর আনুষ্ঠানিক সম্পর্ক নেই।</p>
    <h2>তথ্যের নির্ভুলতা</h2><p>তথ্য যথাসম্ভব নির্ভুল ও ব্যবহারযোগ্য রাখার চেষ্টা করা হয়, কিন্তু সময়সূচি, প্রবেশ নিয়ম, রাস্তার অবস্থা, নিরাপত্তা বিধি বা সেবা পরিবর্তিত হতে পারে। গুরুত্বপূর্ণ তথ্য যাত্রার আগে সরকারি বা স্থানের সাম্প্রতিক উৎসে যাচাই করুন।</p>
    <h2>মেধাস্বত্ব</h2><p>ওয়েবসাইটের নকশা ও মৌলিক লেখা কপিরাইট-সুরক্ষিত। আলোকচিত্রের স্বত্ব মূল আলোকচিত্রীর; মুক্ত লাইসেন্সের ছবি ব্যবহার করলে নির্দিষ্ট কৃতিত্ব ও লাইসেন্স শর্ত মানা হয়। Google Maps ডেটা Google-এর প্রযোজ্য শর্ত অনুযায়ী এমবেড করা হয়েছে।</p>
    <h2>দায়সীমা</h2><p>সাইটটি “যেমন আছে” ভিত্তিতে দেওয়া হয়। এই সাইটের তথ্যের ওপর নির্ভর করে নেওয়া ভ্রমণ সিদ্ধান্তসহ তথ্য ব্যবহারের ফলে সৃষ্ট কোনো পরোক্ষ ক্ষতির জন্য প্রকল্প দায়ী নয়।</p>
  </div></section>
</BaseLayout>
