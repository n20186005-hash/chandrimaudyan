---
import { fetchForecast, normalize, buildHTML, fmtUpdated } from '../lib/weather';

export const prerender = true;

// Server-side fetch at build time renders a snapshot into the static HTML; the
// edge (Cloudflare) then serves that HTML, and a client refresh keeps it fresh.
let raw: any = null;
let rawJson = '';
let staticHtml = '';
let updatedText = 'পূর্বাভাসের সময় পাওয়া যায়নি।';

try {
  raw = await fetchForecast(9000);
  const wx = normalize(raw);
  if (wx) {
    updatedText = 'পূর্বাভাসের সময়: ' + fmtUpdated(wx.observed);
    rawJson = JSON.stringify(raw).replace(/</g, '\\u003c');
    staticHtml = buildHTML(wx);
  }
} catch {
  // Build environment without network keeps empty data; the browser script retries.
}
---
<section class="section weather-section" id="আবহাওয়া" aria-labelledby="weather-title">
  <div class="container">
    <p class="eyebrow">আবহাওয়া</p>
    <h2 class="section-title" id="weather-title">এখনকার অবস্থা ও ৭ দিনের পূর্বাভাস</h2>
    <p class="section-copy">লেকের ধারে হাঁটা বা ছবি তোলার পরিকল্পনা করার আগে তাপমাত্রা, বৃষ্টির সম্ভাবনা ও বাতাসের অবস্থা জেনে নিন। পূর্বাভাস দ্রুত বদলাতে পারে—যাত্রার আগে আবার দেখে নেওয়া ভালো।</p>
    <div class="wx-card card" id="weather-root" aria-live="polite">
      {staticHtml && <div set:html={staticHtml} />}
      {!staticHtml && <p class="wx-fallback">আবহাওয়ার তথ্য এখন পাওয়া যাচ্ছে না। পরে আবার চেষ্টা করুন; স্থানীয় সতর্কতা যাচাই করুন।</p>}
    </div>
    <div class="wx-meta">
      <span id="wx-meta">{updatedText}</span>
      <span>উৎস: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" style="text-decoration:underline">Open-Meteo</a></span>
    </div>
  </div>
</section>

{rawJson && <script type="application/json" id="weather-seed" is:inline set:html={rawJson} />}

<script>
  import { fetchForecast, normalize, buildHTML, fmtUpdated } from '../lib/weather';
  (async () => {
    const root = document.getElementById('weather-root');
    const meta = document.getElementById('wx-meta');
    if (!root) return;
    const seedEl = document.getElementById('weather-seed');
    let shown = false;
    const apply = (raw: unknown) => {
      const wx = normalize(raw);
      if (!wx) return false;
      root.innerHTML = buildHTML(wx); shown = true;
      if (meta) meta.textContent = 'পূর্বাভাসের সময়: ' + fmtUpdated(wx.observed);
      return true;
    };
    // A build snapshot must still be fresh when the document is opened.
    root.innerHTML = '<p class="wx-fallback">আবহাওয়ার তথ্য লোড হচ্ছে…</p>';
    if (seedEl) {
      try { apply(JSON.parse(seedEl.textContent || 'null')); } catch { /* ignore invalid seed */ }
    }
    try { apply(await fetchForecast()); }
    catch {
      if (!shown) {
        root.innerHTML = '<p class="wx-fallback">আবহাওয়ার তথ্য এখন পাওয়া যাচ্ছে না। পরে আবার চেষ্টা করুন; স্থানীয় সতর্কতা যাচাই করুন।</p>';
        if (meta) meta.textContent = 'পূর্বাভাসের সময় পাওয়া যায়নি।';
      } else if (meta) meta.textContent += ' · নতুন তথ্য আনা যায়নি; দেখানো পূর্বাভাসের সময় খেয়াল করুন।';
    }
  })();
</script>
