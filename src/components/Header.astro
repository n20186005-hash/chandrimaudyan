---
import Logo from './Logo.astro';
---
<header class="site-header">
  <div class="container row">
    <Logo />
    <nav id="site-nav" aria-label="প্রধান নেভিগেশন">
      <a href="/#পরিচিতি">পরিচিতি</a>
      <a href="/#ইতিহাস">ইতিহাস</a>
      <a href="/#পরিকল্পনা">পরিকল্পনা</a>
      <a href="/#সুবিধা">সুবিধা</a>
      <a href="/#আবহাওয়া">আবহাওয়া</a>
      <a href="/#যাতায়াত">যাতায়াত</a>
      <a href="/#গল্প">গল্প</a>
      <a href="/#টিপস">টিপস</a>
      <a href="/#প্রশ্ন">প্রশ্ন</a>
    </nav>
    <div class="hdr-actions">
      <a class="map-btn" href="https://maps.app.goo.gl/zYe6CikwUGvDFyes7" target="_blank" rel="noopener noreferrer">মানচিত্র খুলুন</a>
      <button id="menu-toggle" type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" aria-label="মেনু খুলুন"><span class="bars" aria-hidden="true"></span></button>
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const nav = document.getElementById('site-nav');
    const btn = document.getElementById('menu-toggle');
    if (!nav || !btn) return;
    const setOpen = (open) => {
      nav.classList.toggle('open', open);
      btn.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'মেনু বন্ধ করুন' : 'মেনু খুলুন');
    };
    btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => {
      if (e.target && e.target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) setOpen(false);
    });
  })();
</script>
<style>
.site-header{position:sticky;top:0;z-index:40;background:rgba(255,253,247,.9);border-bottom:1px solid rgba(14,75,54,.1);backdrop-filter:blur(14px)}
.row{height:78px;display:flex;align-items:center;justify-content:space-between;gap:1rem}
nav{display:flex;gap:1rem;font-weight:700;color:#365c4f;font-size:.95rem}
nav a:hover{color:#0e4b36}
.hdr-actions{display:flex;align-items:center;gap:.55rem;flex:0 0 auto}
.map-btn{background:#0e4b36;color:white;border-radius:999px;padding:.7rem 1rem;font-weight:800}
.menu-btn{display:none;place-items:center;width:44px;height:44px;border-radius:999px;background:#0e4b36;color:#fff;border:0;cursor:pointer;flex:0 0 auto}
.menu-btn .bars{width:18px;height:2px;background:currentColor;border-radius:99px;position:relative;display:block}
.menu-btn .bars::before,.menu-btn .bars::after{content:'';position:absolute;left:0;width:18px;height:2px;background:currentColor;border-radius:99px;transition:transform .2s ease}
.menu-btn .bars::before{top:-6px}.menu-btn .bars::after{top:6px}
.menu-btn.is-open .bars{background:transparent}
.menu-btn.is-open .bars::before{top:0;transform:rotate(45deg)}
.menu-btn.is-open .bars::after{top:0;transform:rotate(-45deg)}
@media(max-width:980px){
  nav{display:none}
  nav.open{display:flex;position:fixed;top:78px;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:rgba(255,253,247,.99);backdrop-filter:blur(14px);border-bottom:1px solid rgba(14,75,54,.14);box-shadow:0 28px 48px rgba(14,75,54,.18);padding:.3rem 1rem .9rem;max-height:calc(100dvh - 84px);overflow:auto}
  nav.open a{padding:.85rem .2rem;border-bottom:1px solid rgba(14,75,54,.09);font-size:1.02rem}
  .menu-btn{display:grid}
  .map-btn{font-size:.86rem}
}
</style>
