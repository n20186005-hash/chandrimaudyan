---
const seasons = [
  {
    name: 'শীত (নভেম্বর – ফেব্রুয়ারি)',
    weather: 'সবচেয়ে মৃদু ও শুষ্ক সময়; দিনের তাপমাত্রা সাধারণত ১৮–২৮° সে., ভোরে কুয়াশা ও হালকা ঠাণ্ডা পড়তে পারে।',
    advice: 'স্তরে স্তরে পোশাক রাখুন; ভোরে হাঁটার জন্য আরামদায়ক সময়।',
    do: 'হাঁটা, ফটোগ্রাফি, পারিবারিক পিকনিক ও লেকের ধারে বসে সময় কাটানো—সবচেয়ে উপযুক্ত ঋতু।'
  },
  {
    name: 'গ্রীষ্ম (মার্চ – মে)',
    weather: 'উষ্ণ ও শুষ্ক; দিনের তাপমাত্রা অনেক সময় ৩২–৩৮° সে. পর্যন্ত ওঠে, মাঝে মাঝে কালবৈশাখী ঝড়।',
    advice: 'টুপি, সানস্ক্রিন, ছাতা ও পর্যাপ্ত পানি সঙ্গে রাখুন; দুপুরের তীব্র রোদ এড়িয়ে চলুন।',
    do: 'ভোর ও বিকেলের শেষভাগে ঘুরুন; ছায়াযুক্ত পথ ও বেঞ্চ ব্যবহার করুন।'
  },
  {
    name: 'বর্ষা (জুন – সেপ্টেম্বর)',
    weather: 'ভারী বৃষ্টি ও উচ্চ আর্দ্রতা; তাপমাত্রা ২৬–৩২° সে., হঠাৎ বৃষ্টি ও জলজট স্বাভাবিক।',
    advice: 'ছাতা বা রেইনকোট, জলনিরোধ জুতা ও অতিরিক্ত সময় রাখুন; ভেজা পথে সাবধান।',
    do: 'বিক্ষিপ্ত বৃষ্টির ফাঁকে হাঁটুন; মেঘলা আকাশে লেকের প্রতিফলন ছবির জন্য ভালো।'
  },
  {
    name: 'শরৎ / হেমন্ত (অক্টোবর)',
    weather: 'বর্ষা কেটে গিয়ে আবহাওয়া ক্রমে মৃদু হয়; তাপমাত্রা ২৭–৩৩° সে., মাঝে মাঝে হালকা বৃষ্টি।',
    advice: 'হালকা বৃষ্টির জন্য ছাতা রাখুন; এটি শীতের আগে বেড়ানোর ভালো সময়।',
    do: 'উৎসবের মৌসুমে শহরের অন্যান্য দর্শনীয় স্থানের সাথে মিলিয়ে ঘুরুন।'
  }
];
---
<section class="section" id="ঋতু" aria-labelledby="season-title">
  <div class="container">
    <p class="eyebrow">কখন যাবেন</p>
    <h2 class="section-title" id="season-title">ঋতুভিত্তিক ভ্রমণ কৌশল</h2>
    <p class="section-copy">দীর্ঘমেয়াদি গড় জলবায়ু উপাত্ত (৩০ বছরের গড়) অনুযায়ী ঢাকার ঋতুভিত্তিক পরিস্থিতি নিচে তুলে ধরা হলো। এগুলো সাধারণ ধারণা—বের হওয়ার আগে ওপরের আবহাওয়া বিভাগে সর্বশেষ পূর্বাভাস দেখে নিন।</p>
    <div class="season-wrap">
      <table class="season-table">
        <thead>
          <tr><th>ঋতু / সময়</th><th>আবহাওয়া</th><th>পরামর্শ (কী আনবেন)</th><th>উপযুক্ত কাজ</th></tr>
        </thead>
        <tbody>
          {seasons.map((s) => (
            <tr>
              <th scope="row">{s.name}</th>
              <td>{s.weather}</td>
              <td>{s.advice}</td>
              <td>{s.do}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
