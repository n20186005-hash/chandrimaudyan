---
const seasons = [
  {
    name: 'শীত (নভেম্বর – ফেব্রুয়ারি)',
    weather: 'শীতের দিনে তুলনামূলক মৃদু আবহাওয়া হতে পারে; কুয়াশা বা ঠাণ্ডার জন্য প্রস্তুতি রাখুন।',
    advice: 'স্তরে স্তরে পোশাক রাখুন; প্রবেশের সময় মেনে হাঁটার পরিকল্পনা করুন।',
    do: 'প্রবেশ ও কর্মকাণ্ডের অনুমতি থাকলে নিজের স্বাচ্ছন্দ্য অনুযায়ী হাঁটা বা ছবি বেছে নিন; পিকনিক বা বসার সুবিধা নিশ্চিত ধরে নেবেন না।'
  },
  {
    name: 'গ্রীষ্ম (মার্চ – মে)',
    weather: 'গরম ও ঝড়বৃষ্টির প্রস্তুতি রাখুন; দিনের পূর্বাভাস ও স্থানীয় সতর্কতা দেখুন।',
    advice: 'টুপি, সানস্ক্রিন, ছাতা ও পর্যাপ্ত পানি সঙ্গে রাখুন; দুপুরের তীব্র রোদ এড়িয়ে চলুন।',
    do: 'প্রবেশের অনুমতি থাকলে কম রোদে সংক্ষিপ্ত ভ্রমণ রাখুন; ব্যবহারযোগ্য ছায়া বা বসার স্থান পেলে বিশ্রাম নিন।'
  },
  {
    name: 'বর্ষা (জুন – সেপ্টেম্বর)',
    weather: 'বর্ষায় বৃষ্টি ও আর্দ্রতার জন্য প্রস্তুতি দরকার; দিনের পরিস্থিতি বদলাতে পারে।',
    advice: 'ছাতা বা রেইনকোট, জলনিরোধ জুতা ও অতিরিক্ত সময় রাখুন; ভেজা পথে সাবধান।',
    do: 'বিক্ষিপ্ত বৃষ্টির ফাঁকে হাঁটুন; মেঘলা আকাশে লেকের প্রতিফলন ছবির জন্য ভালো।'
  },
  {
    name: 'শরৎ / হেমন্ত (অক্টোবর)',
    weather: 'বৃষ্টি ও গরম দুটির জন্যই নমনীয় পরিকল্পনা রাখুন; দিনের পূর্বাভাসকে অগ্রাধিকার দিন।',
    advice: 'হালকা বৃষ্টির জন্য ছাতা রাখুন; এটি শীতের আগে বেড়ানোর ভালো সময়।',
    do: 'উৎসবের মৌসুমে শহরের অন্যান্য দর্শনীয় স্থানের সাথে মিলিয়ে ঘুরুন।'
  }
];
---
<section class="section" id="ঋতু" aria-labelledby="season-title">
  <div class="container">
    <p class="eyebrow">কখন যাবেন</p>
    <h2 class="section-title" id="season-title">ঋতুভিত্তিক ভ্রমণ কৌশল</h2>
    <p class="section-copy">এটি ঋতুভিত্তিক সাধারণ প্রস্তুতির পরামর্শ, পরিমাপ করা জলবায়ু-গড় বা নির্দিষ্ট দিনের নিশ্চয়তা নয়। প্রবেশের অনুমতি ও সর্বশেষ পূর্বাভাস মিলিয়ে পরিকল্পনা করুন।</p>
    <div class="season-wrap">
      <table class="season-table">
        <thead>
          <tr><th>ঋতু / সময়</th><th>আবহাওয়া</th><th>পরামর্শ (কী আনবেন)</th><th>উপযুক্ত কাজ</th></tr>
        </thead>
        <tbody>
          {seasons.map((s) => (
            <tr>
              <th scope="row">{s.name}</th>
              <td>{s.weather}</td>
              <td>{s.advice}</td>
              <td>{s.do}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
