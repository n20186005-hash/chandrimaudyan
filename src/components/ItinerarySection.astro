---
<section class="section" id="রুট" aria-labelledby="route-title">
  <div class="container">
    <p class="eyebrow">ভ্রমণের রুট</p>
    <h2 class="section-title" id="route-title">গোষ্ঠীভিত্তিক ও সাধারণ রুট</h2>
    <p class="section-copy">আপনার সঙ্গী ও সময় অনুযায়ী সবচেয়ে উপযুক্ত রুট বেছে নিন। নিচে তিন ধরনের গোষ্ঠীর জন্য আলাদা পরামর্শ এবং সংক্ষিপ্ত ভ্রমণ ও পূর্ণদিবস—দুটি সাধারণ রুট দেওয়া হলো।</p>

    <h3 class="sub-title">তিনটি গোষ্ঠী অনুযায়ী</h3>
    <div class="grid-3">
      {groups.map((g) => (
        <article class="card route-group">
          <h4><span aria-hidden="true">{g.ic}</span> {g.title}</h4>
          <p>{g.p}</p>
          <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
        </article>
      ))}
    </div>

    <h3 class="sub-title">সাধারণ রুট (সংক্ষিপ্ত ভ্রমণ ও পূর্ণদিবস)</h3>
    <div class="grid-2">
      {plans.map((p) => (
        <article class="card route-plan">
          <h4>{p.title}</h4>
          <p>{p.p}</p>
          <ol>{p.steps.map((s) => <li>{s}</li>)}</ol>
        </article>
      ))}
    </div>
  </div>
</section>
