<section class="section map-section" id="যাতায়াত" aria-labelledby="transport-title">
  <div class="container">
    <p class="eyebrow">বিস্তারিত যাতায়াত</p>
    <h2 class="section-title" id="transport-title">বিমানবন্দর, রেলস্টেশন ও শহর থেকে কীভাবে যাবেন</h2>
    <p class="section-copy">ঢাকার যানজটের কথা মাথায় রেখে গন্তব্য ও সময় অনুযায়ী সবচেয়ে সুবিধাজনক রুট বেছে নিন। নিচে বিমানবন্দর, দূরপাল্লার টার্মিনাল, শহরের ভেতর ও নিজস্ব গাড়ি—চার ধরনের যাত্রার জন্য পৃথক পরামর্শ দেওয়া হলো।</p>
    <div class="route-cols">
      {routes.map((r) => (
        <article class="card route-card">
          <h3><span aria-hidden="true">{r.ic}</span> {r.title}</h3>
          <p>{r.p}</p>
          <ul>
            {r.items.map((it) => <li>{it}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="map-card card">
      <iframe
